# NumberShield Environment Configuration
# Copy this file to .env to customize local settings.
# NumberShield requires ZERO paid credentials or cloud accounts.

# Host and Port Configuration (Default: Localhost only)
NUMBERSHIELD_HOST=127.0.0.1
NUMBERSHIELD_PORT=8765

# Local Storage Database Path
NUMBERSHIELD_DB_PATH=data/numbershield.db

# Optional SearXNG Meta-Search Instance
# You can leave this empty to use default public instances or point to your own local SearXNG docker.
# Example: http://localhost:8080 or https://priv.au
SEARXNG_INSTANCE_URL=

# Rate Limiting & Timeouts
NUMBERSHIELD_REQUEST_TIMEOUT_SECONDS=10
NUMBERSHIELD_MAX_RESPONSE_SIZE_BYTES=5242880
NUMBERSHIELD_POLITE_DELAY_SECONDS=1.5

# Debug & Log Mode (Options: INFO, DEBUG, WARNING)
# Phone numbers are always masked regardless of log level.
LOG_LEVEL=INFO
